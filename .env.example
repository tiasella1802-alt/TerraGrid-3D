# Copy to .env (git-ignored). The dev server and the chain scripts read it; shell variables take precedence.

# Live Gemini ranking and council brief (optional)
GEMINI_API_KEY=

# Ledger network: "local" (npm run chain) or "sepolia" (Ethereum public testnet)
CHAIN_NETWORK=local

# Sepolia only. Use TESTNET-ONLY wallets that have never held real funds.
# Fund them with free Sepolia test ETH from a faucet, then: npm run chain:deploy:sepolia
CHAIN_RPC=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_KEY=
CHAIN_VERIFIER_KEY=
